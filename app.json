{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "scheme": "timefit",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "web"
    ],
    "icon": "./assets/jjaturi-icon-blue.png",
    "plugins": [
      [
        "./plugins/withTimeFitLiveActivity.cjs",
        {
          "appGroupIdentifier": "group.com.dongheun.mobile.timefit",
          "developmentTeam": "642X5R37S7",
          "extensionBundleIdentifier": "com.dongheun.mobile.liveactivity"
        }
      ],
      "./plugins/withoutPushEntitlement.cjs",
      "./plugins/withoutLocationPermissions.cjs",
      "expo-notifications",
      "expo-status-bar",
      "expo-font",
      "expo-web-browser"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "config": {
        "usesNonExemptEncryption": false
      },
      "supportsTablet": false,
      "buildNumber": "1",
      "deploymentTarget": "17.0",
      "bundleIdentifier": "com.dongheun.mobile",
      "infoPlist": {
        "CFBundleDisplayName": "짜투리",
        "LSApplicationQueriesSchemes": [
          "kakaomap"
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
