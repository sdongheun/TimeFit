/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; connect-src 'none'; frame-src 'none'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/privacy/*
  Cache-Control: public, max-age=300

/terms/*
  Cache-Control: public, max-age=300

/support/*
  Cache-Control: public, max-age=300
